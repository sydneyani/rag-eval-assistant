# CiteGround configuration.
# Copy to .env. Never commit real keys. With no key, the app stays on the offline providers.

# Unprefixed so it matches the OpenAI convention. Leave blank for offline runs.
OPENAI_API_KEY=

# auto: OpenAI when a key is present, otherwise the offline provider.
CITEGROUND_LLM_PROVIDER=auto
CITEGROUND_EMBEDDING_PROVIDER=auto
CITEGROUND_CHAT_MODEL=gpt-4o-mini
CITEGROUND_EMBEDDING_MODEL=text-embedding-3-small
CITEGROUND_OPENAI_BASE_URL=https://api.openai.com/v1

# Offline hashing embedder width. Ignored by the OpenAI embedder.
CITEGROUND_EMBEDDING_DIM=256

CITEGROUND_CORPUS_DIR=data/corpus
CITEGROUND_INDEX_DIR=data/index
CITEGROUND_VECTOR_STORE=numpy

# fixed, recursive, or sentence
CITEGROUND_CHUNKER=recursive
CITEGROUND_CHUNK_SIZE=900
CITEGROUND_CHUNK_OVERLAP=150
CITEGROUND_SENTENCE_WINDOW=3
CITEGROUND_SENTENCE_STRIDE=2

# hybrid, bm25, or dense
CITEGROUND_RETRIEVAL_MODE=hybrid
CITEGROUND_TOP_K=5
CITEGROUND_CANDIDATE_K=20
CITEGROUND_RRF_K=60
CITEGROUND_RERANK=true

CITEGROUND_TRACES_PATH=data/traces/traces.jsonl

# Approximate list prices in USD per 1M tokens. Used only for cost estimates.
# Override when the provider price changes. Offline providers report zero cost.
CITEGROUND_PRICE_CHAT_INPUT_PER_MTOK=0.15
CITEGROUND_PRICE_CHAT_OUTPUT_PER_MTOK=0.60
CITEGROUND_PRICE_EMBEDDING_PER_MTOK=0.02

# Comma-separated browser origins allowed to call the API.
CITEGROUND_CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
